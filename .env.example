# SpendWise Environment Configuration

# Backend Settings
APP_NAME=SpendWise
DEBUG=True
SECRET_KEY=change-this-to-a-super-secret-hex-token-in-production-min-32-chars

# PostgreSQL Database Configuration
# Local Development (if Postgres running on localhost:5432):
DATABASE_URL=postgresql+psycopg://spendwise_user:spendwise_password@localhost:5432/spendwise
# Docker Service Host:
# DATABASE_URL=postgresql+psycopg://spendwise_user:spendwise_password@db:5432/spendwise

ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost","http://localhost:80"]

# Frontend Settings (Vite)
VITE_API_BASE_URL=http://localhost:8000
